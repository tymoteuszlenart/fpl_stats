# Copy to .env and fill in your values.
# FPL_COOKIE: session cookie from https://fantasy.premierleague.com/api/me
FPL_COOKIE=your_fpl_cookie_here
# FPL_LEAGUE_ID: numeric id of your classic league
FPL_LEAGUE_ID=your_league_id_here
# Optional fetch range (see README): finished | current | full
# FPL_FETCH_MODE=finished
# FPL_MAX_GW=38
