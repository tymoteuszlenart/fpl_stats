# Secrets and local env
.env

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Virtual environment
venv/

# Generated data and reports (do not commit)
csv/
fpl_output/
*.csv
*.pdf
*.html

# Local scratch test data (committed suite lives under tests/)
test/

# Allow committed pytest fixtures; ignore other CSV at repo root
!tests/
!tests/fixtures/
!tests/fixtures/**/*.csv
